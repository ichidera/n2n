<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required so PackageManager.getPackageInfo() can see these packages
         under Android 11+ package-visibility rules. Without this,
         EmulatorDetector's package-based checks would silently report
         "not found" for every one of them regardless of what's actually
         installed on the device. -->
    <queries>
        <package android:name="com.microvirt.launcher2" />
        <package android:name="com.microvirt.tools" />
        <package android:name="com.microvirt.installer" />
        <package android:name="com.microvirt.download" />
        <package android:name="com.microvirt.memuime" />
        <package android:name="com.bluestacks.home" />
        <package android:name="com.bluestacks.settings" />
        <package android:name="com.bluestacks.appmart" />
        <package android:name="com.bluestacks.BstCommandProcessor" />
        <package android:name="com.bignox.app" />
        <package android:name="com.vphone.launcher" />
        <package android:name="org.bignox.tools" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="LAN Bridge"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TunLanService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="lan_bridge_vpn_tunnel" />
        </service>

    </application>
</manifest>